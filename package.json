{
  "name": "@zoliszabo/postcss-nested-import-tailwind",
  "version": "1.7.0",
  "description": "PostCSS plugin for importing other stylesheet source files anywhere in your CSS. With Tailwind support.",
  "keywords": [
    "postcss",
    "css",
    "postcss-plugin",
    "import",
    "tailwind"
  ],
  "author": "Erik Harper <eriklharper@gmail.com>",
  "contributors": [
    "Zoli Szabó <zoli.szabo+github@gmail.com>"
  ],
  "license": "MIT",
  "repository": "zoliszabo/postcss-nested-import-tailwind",
  "bugs": {
    "url": "https://github.com/zoliszabo/postcss-nested-import-tailwind/issues"
  },
  "homepage": "https://github.com/zoliszabo/postcss-nested-import-tailwind",
  "scripts": {
    "unit": "uvu . '\\.test\\.(ts|js)$'",
    "test": "c8 npm run unit && eslint .",
    "format": "prettier --write . --ignore-unknown"
  },
  "peerDependencies": {
    "postcss": "^8.3.0"
  },
  "engines": {
    "node": ">=12.0"
  },
  "prettier": {
    "trailingComma": "none"
  },
  "c8": {
    "exclude": [
      "**/*.test.*"
    ],
    "lines": 100,
    "check-coverage": true
  },
  "devDependencies": {
    "@logux/eslint-config": "^57.0.2",
    "c8": "^10.1.3",
    "csso": "^5.0.5",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.28.0",
    "eslint-plugin-n": "^17.24.0",
    "eslint-plugin-prefer-let": "^4.1.0",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-promise": "^7.2.1",
    "jest": "^30.2.0",
    "postcss": "^8.4.27",
    "prettier": "^3.0.1",
    "uvu": "^0.5.6"
  },
  "dependencies": {
    "resolve": "^1.22.4"
  }
}
